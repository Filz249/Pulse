<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_pulse_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PULSE"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.16" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Nothing playing"
        android:textColor="#FFF6EEE5"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Open Pulse to choose a song"
        android:textColor="#FFB9AAA0"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Play or pause"
            android:padding="9dp"
            android:src="@android:drawable/ic_media_play"
 />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="Next song"
            android:padding="9dp"
            android:src="@android:drawable/ic_media_next"
 />
    </LinearLayout>
</LinearLayout>
