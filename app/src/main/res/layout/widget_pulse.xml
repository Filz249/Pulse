<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pulse_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/widget_backdrop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B80C0A09" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="0dp">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:contentDescription="Current album artwork"
            android:scaleType="fitXY"
            android:src="@drawable/ic_pulse_equalizer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ready To Play"
                android:textColor="#FFF6EEE5"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Choose a song in Pulse"
                android:textColor="#FFD1C5B8"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_favorite"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Favorite current song"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_heart" />

                <ImageButton
                    android:id="@+id/widget_previous"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Previous song"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_previous" />

                <ImageButton
                    android:id="@+id/widget_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_play_button_bg"
                    android:contentDescription="Play or pause"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_play" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Next song"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_next" />

                <ImageButton
                    android:id="@+id/widget_open"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Open Pulse queue"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_queue" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>