<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_pulse_background"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="124dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="14dp"
        android:background="@drawable/widget_pulse_background"
        android:contentDescription="Current album artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_pulse_equalizer" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ready To Play"
            android:textColor="#FFF6EEE5"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Choose a song in Pulse"
            android:textColor="#FFB9AAA0"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_favorite"
                android:layout_width="36dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Favorite current song"
                android:padding="5dp"
                android:src="@drawable/widget_ic_heart" />

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="40dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Previous song"
                android:padding="7dp"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/widget_play_button_bg"
                android:contentDescription="Play or pause"
                android:padding="13dp"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="40dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Next song"
                android:padding="7dp"
                android:src="@android:drawable/ic_media_next" />

            <ImageButton
                android:id="@+id/widget_open"
                android:layout_width="40dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="Open Pulse playlist"
                android:padding="7dp"
                android:src="@android:drawable/ic_menu_sort_by_size" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>