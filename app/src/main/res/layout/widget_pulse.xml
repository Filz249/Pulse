<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pulse_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:background="#FF211B18" />

    <ImageView
        android:id="@+id/widget_backdrop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="0dp">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:contentDescription="Current album artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pulse_equalizer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="9dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ready To Play"
                android:textColor="#FFF6EEE5"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Choose a song in Pulse"
                android:textColor="#FFD1C5B8"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1">
                    <ImageButton android:id="@+id/widget_favorite" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@android:color/transparent" android:contentDescription="Favorite current song" android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/widget_ic_heart" />
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1">
                    <ImageButton android:id="@+id/widget_previous" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@android:color/transparent" android:contentDescription="Previous song" android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/widget_ic_previous" />
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1">
                    <ImageButton android:id="@+id/widget_play_pause" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:background="@drawable/widget_play_button_bg" android:contentDescription="Play or pause" android:padding="7dp" android:scaleType="fitCenter" android:src="@drawable/widget_ic_play" />
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1">
                    <ImageButton android:id="@+id/widget_next" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@android:color/transparent" android:contentDescription="Next song" android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/widget_ic_next" />
                </FrameLayout>
                <FrameLayout android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1">
                    <ImageButton android:id="@+id/widget_open" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:background="@android:color/transparent" android:contentDescription="Open Pulse queue" android:padding="5dp" android:scaleType="fitCenter" android:src="@drawable/widget_ic_queue" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>