<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_pulse_background"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_artwork"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_pulse_background"
        android:contentDescription="Current album artwork"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_pulse_equalizer" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ready To Play"
            android:textColor="#FFF6EEE5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Choose a song in Pulse"
            android:textColor="#FFB9AAA0"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_favorite"
                android:layout_width="25dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Favorite current song"
                android:focusable="false"
                android:padding="4dp"
                android:src="@drawable/widget_ic_heart" />

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="27dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Previous song"
                android:focusable="false"
                android:padding="5dp"
                android:src="@android:drawable/ic_media_previous" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_play_button_bg"
                android:clickable="true"
                android:contentDescription="Play or pause"
                android:focusable="false"
                android:padding="7dp"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="27dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Next song"
                android:focusable="false"
                android:padding="5dp"
                android:src="@android:drawable/ic_media_next" />

            <ImageButton
                android:id="@+id/widget_open"
                android:layout_width="25dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="Open Pulse"
                android:focusable="false"
                android:padding="5dp"
                android:src="@android:drawable/ic_menu_sort_by_size" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>